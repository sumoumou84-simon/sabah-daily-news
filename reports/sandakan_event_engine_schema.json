{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sabah-daily-news.org/schemas/sandakan-event-schema-v1.json",
  "title": "SandakanEventDatabaseSchema",
  "description": "Standard schema for validating Sandakan 14-Day Event Engine entities and feeds.",
  "type": "object",
  "required": [
    "audit_metadata",
    "events"
  ],
  "properties": {
    "audit_metadata": {
      "type": "object",
      "required": [
        "audit_timestamp",
        "auditor",
        "reference_window_start",
        "reference_window_end",
        "total_candidates_audited",
        "approved_for_publication_count"
      ],
      "properties": {
        "audit_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "auditor": {
          "type": "string"
        },
        "reference_window_start": {
          "type": "string",
          "format": "date-time"
        },
        "reference_window_end": {
          "type": "string",
          "format": "date-time"
        },
        "total_candidates_audited": {
          "type": "integer",
          "minimum": 0
        },
        "approved_for_publication_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_historical_count": {
          "type": "integer",
          "minimum": 0
        },
        "gemini_api_calls_used": {
          "type": "integer",
          "enum": [0]
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EventEntity"
      }
    }
  },
  "definitions": {
    "EventEntity": {
      "type": "object",
      "required": [
        "event_id",
        "official_name_en",
        "official_name_ms",
        "official_name_zh",
        "category",
        "organiser_primary",
        "primary_source_url",
        "venue_name",
        "district",
        "coordinates",
        "start_datetime",
        "end_datetime",
        "source_reliability_tier",
        "verification_status",
        "event_status",
        "is_approved_for_publication"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^EVT-SDK-[0-9]{4}-[0-9]{3,}$"
        },
        "official_name_en": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "official_name_ms": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "official_name_zh": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "Ecotourism & Community Festival",
            "Sports & Running",
            "Sports Logistics & Expo",
            "Major Sporting Event",
            "Cultural & Martial Arts Championship",
            "Municipal & Environment",
            "Public Health & Civic",
            "General Community"
          ]
        },
        "organiser_primary": {
          "type": "string",
          "minLength": 2
        },
        "co_organisers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_source_url": {
          "type": "string",
          "format": "uri"
        },
        "secondary_source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "venue_name": {
          "type": "string",
          "minLength": 3
        },
        "venue_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "district": {
          "type": "string",
          "enum": [
            "Sandakan"
          ]
        },
        "coordinates": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": 5.5,
              "maximum": 6.2
            },
            "longitude": {
              "type": "number",
              "minimum": 117.5,
              "maximum": 118.5
            }
          }
        },
        "start_datetime": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_datetime": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "SINGLE_EVENT",
            "MULTI_DAY_EVENT",
            "RECURRING_EVENT",
            "EVENT_CALENDAR",
            "UNKNOWN"
          ]
        },
        "source_reliability_tier": {
          "type": "string",
          "enum": [
            "TIER_1_OFFICIAL",
            "TIER_2_ESTABLISHED_ORGANISER",
            "COMMERCIAL_TICKET_LISTING",
            "TIER_3_MAINSTREAM_MEDIA",
            "TIER_4_SOCIAL_DISCOVERY"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "OFFICIAL_CONFIRMED",
            "MULTI_SOURCE_CONFIRMED",
            "DISCOVERED",
            "UNVERIFIED",
            "CONFLICTED"
          ]
        },
        "event_status": {
          "type": "string",
          "enum": [
            "LIVE_NOW",
            "TODAY",
            "UPCOMING",
            "COMPLETED",
            "CANCELLED",
            "POSTPONED",
            "SOLD_OUT",
            "REGISTRATION_CLOSED",
            "UNKNOWN"
          ]
        },
        "is_approved_for_publication": {
          "type": "boolean"
        },
        "verified_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverified_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_stale": {
          "type": "boolean"
        },
        "last_checked_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_date_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_precision": {
          "type": "string",
          "enum": [
            "EXACT_DATETIME",
            "DATE_ONLY"
          ]
        },
        "cancellation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_status_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_status_source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "change_history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
